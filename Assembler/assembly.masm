!ldc_direct #0
!ldc_label #0
!sum #0
!i #0
!limit #5
!const_seven #7

@main
    LDC !const_seven
    STC !ldc_direct
    LDC @subroutine
    STC !ldc_label
    JMPI
    JMP @loop

@loop
    LDA !i
    LDB #1
    ADD
    STC !i
    LDA !sum
    LDB !i
    ADD
    STC !sum
    LDA !i
    LDB !limit
    CMP
    JMPN @loop
    JMP @done

@subroutine
    RET

@done
    HAL
